<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Your servers · Velora X1</title><link rel="stylesheet" href="/style.css"></head><body><nav class="nav"><a class="brand" href="/"><span class="mark">V</span> VELORA <b>X1</b></a><div><span class="user"><%= user.username %></span><a href="/">Home</a><form class="inline" method="post" action="/auth/logout"><button class="link-btn">Log out</button></form></div></nav><main class="dashboard"><p class="eyebrow">CONTROL CENTER</p><h1>Your servers</h1><p class="lead">Choose a server where you have Manage Server permission and Velora X1 is installed.</p><div class="guild-grid"><% guilds.forEach(g=>{ %><article class="guild"><div class="guild-icon"><%= g.name.slice(0,1).toUpperCase() %></div><h3><%= g.name %></h3><p><%= g.botPresent ? "Velora X1 is installed" : "Bot not installed" %></p><% if(g.botPresent){ %><a class="btn small" href="/dashboard/<%= g.id %>">Manage server</a><% }else{ %><a class="btn small" href="/invite">Add bot</a><% } %></article><% }) %></div><% if(!guilds.length){ %><p>No manageable servers were returned by Discord.</p><% } %></main></body></html>
