<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= guild.name %> · Velora X1</title><link rel="stylesheet" href="/style.css"><script defer src="/dashboard.js"></script></head><body><nav class="nav"><a class="brand" href="/"><span class="mark">V</span> VELORA <b>X1</b></a><div><a href="/dashboard">All servers</a><span class="user"><%= user.username %></span></div></nav><main class="dashboard"><a href="/dashboard" class="back">← All servers</a><p class="eyebrow">SERVER CONFIGURATION</p><h1><%= guild.name %></h1><% if(new URLSearchParams(location.search).get("saved")) { %><p class="success">Settings saved.</p><% } %><form class="settings panel" method="post" action="/dashboard/<%= guild.id %>/settings"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><label>Prefix<input name="prefix" maxlength="5" value="<%= settings.prefix %>" required></label><label>Moderation log channel<select name="log_channel_id"><option value="">Not configured</option><% channels.forEach(c=>{ %><option value="<%= c.id %>" <%= settings.log_channel_id===c.id?"selected":"" %>>#<%= c.name %></option><% }) %></select></label><label>Welcome channel<select name="welcome_channel_id"><option value="">Not configured</option><% channels.forEach(c=>{ %><option value="<%= c.id %>" <%= settings.welcome_channel_id===c.id?"selected":"" %>>#<%= c.name %></option><% }) %></select></label><label class="toggle"><input type="checkbox" name="anti_raid" <%= settings.anti_raid ? "checked" : "" %>> Enable join-spike alerts (8+ joins in 15 seconds)</label><p class="tiny">This setting alerts staff; it does not automatically punish members.</p><button class="btn">Save settings</button></form>
<section class="panel help-sort"><h2>Help menu order</h2><p>Drag categories to reorder how you want the dashboard help menu arranged.</p><ul id="help-order" data-guild="<%= guild.id %>" data-csrf="<%= csrfToken %>"><% order.forEach(c=>{ %><li draggable="true"><span class="drag">⠿</span><span><%= c %></span><small>Drag to move</small></li><% }) %></ul><p id="sort-status" class="tiny">Changes save when you release a category.</p></section>
</main></body></html>
