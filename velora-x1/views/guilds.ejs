<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Your servers · Velora X1</title><link rel="stylesheet" href="/style.css"></head><body><nav class="nav"><a class="brand" href="/"><span class="mark">V</span> VELORA <b>X1</b></a><div><span class="user"><%= user.username %></span><form method="post" action="/auth/logout" class="inline"><button class="link-button">Logout</button></form></div></nav><main class="dashboard"><p class="eyebrow">CONTROL CENTER</p><h1>Your servers</h1><p class="lead">Choose a server where you have Manage Server permissions and Velora X1 is installed.</p><div class="guild-grid"><% guilds.forEach(g=>{ %><article class="guild-card"><div class="guild-icon"><%= g.name.slice(0,1).toUpperCase() %></div><div class="guild-info"><h3><%= g.name %></h3><p><%= g.botPresent?'Bot connected':'Bot not installed' %></p></div><% if(g.botPresent){ %><a class="btn small" href="/dashboard/<%= g.id %>">Manage server</a><% }else{ %><a class="btn small secondary" href="/invite">Invite bot</a><% } %></article><% }) %></div><% if(!guilds.length){ %><div class="panel"><h2>No manageable servers found</h2><p>Check your Discord account and Manage Server permission.</p></div><% } %></main></body></html>
